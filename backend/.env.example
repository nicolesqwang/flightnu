# Free Postgres that never expires: create a project at https://neon.tech and
# paste its connection string. Leave unset locally to use SQLite (flightnu.db).
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/flightnu?sslmode=require
ENVIRONMENT=development

# Real flight prices (free): sign up at https://www.travelpayouts.com, join the
# Aviasales program, copy the API token from your profile.
PRICE_PROVIDER=travelpayouts
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=us

# Optional (free plan = 250 searches/month): https://serpapi.com
# Backfills ~60 days of real Google Flights price history for each new tracker
# and is used when Aviasales has no cached fare for a route.
SERPAPI_KEY=

# Shared secret the GitHub Action sends to /api/internal/ingest.
CRON_SECRET=
# Required to delete / pause trackers from the site (enter it once in the UI).
ADMIN_KEY=
MAX_ACTIVE_TRACKERS=12
AUTO_SEED=true

DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

CORS_ORIGINS=http://localhost:3000
